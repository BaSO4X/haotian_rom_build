#DPI
persist.miui.density_v2=600
ro.sf.lcd_density=600
ro.millet.netlink=31
#音质音效
ro.vendor.audio.fweffect=true
ro.vendor.audio.bose.effect.enable=true
ro.vendor.audio.sfx.harmankardon=true
#扬声器清理
ro.vendor.audio.clean_speaker=true
#Log
persist.logd.limit=OFF
persist.logd.size=65536
persist.logd.size.crash=1M
persist.logd.size.radio=1M
persist.logd.size.system=1M
log.tag.stats_log=OFF
ro.logd.size=64K
ro.logd.size.stats=64K
vendor.bluetooth.startbtlogger=false
persist.sys.offlinelog.kernel=false
sys.miui.ndcd=off
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0
persist.wpa_supplicant.debug=false
persist.sys.offlinelog.logcat=false
persist.sys.offlinelog.logcatkernel=false
persist.sys.sysrqOnAnr_D_state=false 
persist.sys.wifi_track=false 
persist.vendor.wifienhancelog=0 
service.offlinelog.bootloader=false
persist.logd.diag.tcpdump=0
persist.sys.qseelogd=0
persist.sys.ssr.enable_debug=0
persist.vendor.sys.rawdump_copy=0
vendor.bluetooth.startbtlogger=0
persist.iorapd.log.verbose=false
#dex2oat
persist.miui.dexopt.first_use=true
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3,4,5,6,7
#不显示pwm开关
ro.display.enable_pwm_switch=false