  unzip -p "$ZIPFILE" $1 >$2
}

package_extract_zstd() {
    unzip -p "$ZIPFILE" $1 | /tmp/bin/android/zstd -k -d >$2
}

getVolumeKey() {
	ui_print "- 监听音量键 按[+]选择"是" 按[-]选择"否""
	keyInfo=true
	while $keyInfo;do
		keyInfo=$(getevent -qlc 1 |grep KEY_VOLUME)
		if [ "$keyInfo" == "" ];then
			continue
		else
			isUpKey=$(echo $keyInfo |grep KEY_VOLUMEUP)
			[ "$isUpKey" != "" ] && return 0 || return 1
			break
		fi
	done
}



